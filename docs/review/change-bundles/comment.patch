+
+  PRIMARY KEY(id),
+  UNIQUE(login_id),
+  UNIQUE(email_address),
+  CHECK(status IN ('ACTIVE', 'DELETED')),
+  CHECK(role IN ('USER', 'ADMIN')),
+  CHECK(status = 'DELETED' OR login_id IS NOT NULL),
+  CHECK(status = 'DELETED' OR password IS NOT NULL),
+  CHECK(status = 'DELETED' OR name IS NOT NULL),
+  CHECK(status = 'DELETED' OR email_address IS NOT NULL)
