+    ON DELETE CASCADE
+    ON UPDATE CASCADE,
+  FOREIGN KEY(parent_comment) REFERENCES comments(id)
+    ON DELETE CASCADE
+    ON UPDATE CASCADE
+);
+
+CREATE TABLE report (
