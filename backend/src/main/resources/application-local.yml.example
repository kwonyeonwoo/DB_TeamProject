spring:
  datasource:
    url: jdbc:mysql://localhost:3306/academic_share?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
    username: ${DB_USERNAME}
    password: ${DB_PASSWORD}
    driver-class-name: com.mysql.cj.jdbc.Driver
  jpa:
    hibernate:
      ddl-auto: validate
  flyway:
    enabled: true
    locations: classpath:db/migration

# MariaDB를 사용할 경우 datasource 예시:
# spring:
#   datasource:
#     url: jdbc:mariadb://localhost:3306/academic_share
#     username: ${DB_USERNAME}
#     password: ${DB_PASSWORD}
#     driver-class-name: org.mariadb.jdbc.Driver
